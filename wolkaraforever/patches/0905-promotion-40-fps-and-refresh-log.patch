@@ -240,6 +262,18 @@ static void AKBatterySaverRecordPace(id<MTLDrawable> drawable, CFTimeInterval pr
     if(layer) objc_setAssociatedObject(layer, &paceMarker, @(presented), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
 }
 
+// The minimum duration a capped frame is held for. Exactly the cap's interval sits on a refresh
+// boundary - 25 ms is three 120 Hz refreshes to the nanosecond - and on an iPhone Duo whole
+// seconds of a 40 cap came out at 33.3 ms, four refreshes, with the screen at 120 Hz. Holding
+// 2 ms less keeps the intended count at every rate the policy uses (2 ms is under a quarter of
+// a 120 Hz refresh, and every cap's interval is more than a refresh above the count below it)
+// without the coin toss. Timed presentation keeps the full interval: a target time is not
+// rounded the same way.
+#define AK_PACE_HOLD_SLACK 0.002
+static double AKBatterySaverHold(double interval) {
+    return interval > 2.0 * AK_PACE_HOLD_SLACK ? interval - AK_PACE_HOLD_SLACK : interval;
+}
