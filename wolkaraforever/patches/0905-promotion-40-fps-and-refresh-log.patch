-__attribute__((visibility("default"))) void AKDisableMetalFrameStatistics(void) { atomic_store(&s_recordFrames, false); }
+__attribute__((visibility("default"))) void AKDisableMetalFrameStatistics(void) { if (!atomic_load(&s_rateTest)) atomic_store(&s_recordFrames, false); }
 
 // Battery Saver: a frame cap applied at the presentation call the guest itself makes.
