@@ -453,7 +487,14 @@ static void observedPresentAt(id command,SEL selector,id<MTLDrawable> drawable,C
     // atTime: is the guest's own timing, so it is preserved: the frame is presented no
     // earlier than the cap allows, and never earlier than the guest asked for.
     CFTimeInterval target=AKBatterySaverPaceTarget(drawable,interval);
-    if(target>time) { atomic_fetch_add(&s_paceRaised,1); originalPresentAt(command,selector,drawable,target); }
+    // When the cap is what decides, hold the previous frame for the interval instead of
+    // naming a host time. A time lands on whichever refresh follows it, so 25 ms targets on a
+    // 60 Hz rhythm alternate 16.7 and 33.3 ms; a minimum duration rounds up to whole
+    // refreshes and gives a steady 30 there and a steady 40 at 120 Hz. The guest's own later
+    // time is still kept below. Without minimum-duration presentation (the simulator), the
+    // timed target as before.
+    if(target>time && originalPresentAfter) { atomic_fetch_add(&s_paceRaised,1); originalPresentAfter(command,@selector(presentDrawable:afterMinimumDuration:),drawable,AKBatterySaverHold(interval)); }
+    else if(target>time) { atomic_fetch_add(&s_paceRaised,1); originalPresentAt(command,selector,drawable,target); }
     else { atomic_fetch_add(&s_paceKept,1); AKBatterySaverRecordPace(drawable,time); originalPresentAt(command,selector,drawable,time); }
 }
