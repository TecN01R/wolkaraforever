+static NSString *timeOfDay(void) {
+    static NSDateFormatter *format; static dispatch_once_t once;
+    dispatch_once(&once, ^{ format = [NSDateFormatter new]; format.dateFormat = @"HH:mm:ss.SSS"; });
+    @synchronized(format) { return [format stringFromDate:NSDate.date]; }
+}
