     @synchronized(seen) {
@@ -23,7 +34,7 @@
         else if (seen.count >= 1500 || [seen containsObject:line]) return;
         else [seen addObject:line];
     }
-    AKLog(@"metal %@%@", failed ? @"FAILED " : @"", line);
+    AKLog(@"%@ metal %@%@", timeOfDay(), failed ? @"FAILED " : @"", line);
 }
