@@ -7,7 +8,8 @@ CGFloat AKGuestBackingScale(void) { return AKConfiguredGuestBackingScale(); }
 + (NSArray *)screens { return @[self.mainScreen]; }
 - (NSRect)frame {
     CGSize size;
