+- (NSInteger)maximumFramesPerSecond {
+    // The same screen the frame describes, not UIScreen.mainScreen (see AKGuestDisplayFallback.h).
+    double refresh;
+    if (!AKGetGuestDisplayGeometry(NULL,&refresh)) AKGuestDisplayFallback(NULL,&refresh);
+    return MAX((NSInteger)1,(NSInteger)refresh);
+}
