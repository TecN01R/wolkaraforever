<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>WolkaraForever reaches this iPhone's own developer service to enable JIT for the game.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_remotepairing._tcp</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>TolkaraGuestRuntime</key>
	<string>$(GUEST_RUNTIME)</string>
	<key>TolkaraPreselectedExecutionMode</key>
	<string>$(TOLKARA_MODE)</string>
	<key>NSFaceIDUsageDescription</key>
	<string>WolkaraForever uses Face ID to unlock the game password you chose to save on this device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>WolkaraForever uses the microphone to turn what you say into text in the game's chat, and for in-game voice chat. Speech recognition runs on this iPad.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn what you say into text in the game. Recognition runs on this iPad.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- iOS Game Mode: iOS turns it on a few seconds after a game comes to the front, and with the
	     increased-memory-limit entitlement the app's memory limit rises with it (measured by
	     Playport on a 12 GB iPhone, iOS 27: 6,144 MB before, 8,192 MB after). -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>GCSupportsGameMode</key>
	<true/>
	<!-- Personal branch: lets the game be shown at up to 120 Hz on a ProMotion iPhone. With
	     Battery Saver's frame limit Off, the game's own Max Foreground FPS is the limit; Battery
	     Saver's 40 is every third refresh at 120 Hz (BatterySaverPolicy.h). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
